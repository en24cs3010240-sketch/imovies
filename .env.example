# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave empty or use default to use auto in-memory MongoDB replica for development)
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# Authentication
JWT_SECRET=super_secret_jwt_key_imovies_2026_change_in_production
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173

# Seat Hold Timeout (in minutes)
SEAT_HOLD_DURATION_MINUTES=8
